# Configuração de PRODUÇÃO (VPS com Docker — infra/production/compose.yaml).
# Copie para `.env.production` na raiz do projeto, no servidor. Esse arquivo é
# ignorado pelo git e pela imagem Docker: NUNCA o commite.
# Gere senhas com: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# Domínio público (o DNS deve apontar para o IP do servidor) e email para
# avisos do Let's Encrypt (certificado HTTPS).
APP_DOMAIN=chamados.suafaculdade.edu.br
ACME_EMAIL=ti@suafaculdade.edu.br
APP_TIMEZONE=America/Sao_Paulo

# Banco de dados. O superusuário só é usado na criação do banco e para
# administração; a aplicação usa APP_DB_USER, sem privilégios de superusuário.
# Atenção: estes usuários são criados só na PRIMEIRA subida do banco.
POSTGRES_DB=campusconnect
POSTGRES_ADMIN_PASSWORD=
APP_DB_USER=campusconnect_app
APP_DB_PASSWORD=

# Dias de backups mantidos no servidor (infra/production/backups).
BACKUP_KEEP_DAYS=14

# SMTP real com TLS (porta 465 + SECURE=true, ou 587 + SECURE=false/STARTTLS).
# Ex.: o servidor de email da instituição, Google Workspace, Amazon SES, Brevo...
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM="CampusConnect <nao-responda@suafaculdade.edu.br>"

# LGPD: dados exibidos na Política de Privacidade (/privacidade). Os valores
# abaixo são EXEMPLOS: a instituição (jurídico/DPO) deve definir os reais.
# Enquanto algum faltar, a página mostra um aviso de "texto modelo".
PRIVACY_CONTROLLER_NAME="Nome da Instituição de Ensino"
PRIVACY_CONTACT_EMAIL=dpo@suafaculdade.edu.br
PRIVACY_LEGAL_BASIS="execução de contrato e de procedimentos preliminares relacionados ao vínculo acadêmico (art. 7º, V, da LGPD)"
