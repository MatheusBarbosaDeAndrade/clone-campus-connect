# Variáveis de ambiente para a VERCEL (Project → Settings → Environment
# Variables). Este arquivo é só referência: cadastre os valores no painel,
# marcando o ambiente "Production". NUNCA commite valores reais.

# Banco (Neon pela integração da Vercel já cria as duas URLs automaticamente).
# DATABASE_URL = conexão COM pooling (usada pelo app).
# DATABASE_URL_UNPOOLED = conexão direta (usada só pelas migrations no build).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_POOL_MAX=3

# Endereço público (o seu domínio), usado nos links enviados por e-mail.
APP_URL=https://chamados.seudominio.com.br
APP_TIMEZONE=America/Sao_Paulo
# A Vercel informa o IP real do cliente no X-Forwarded-For.
TRUST_PROXY=true

# Anexos: a Vercel aceita no máximo 4,5 MB por requisição.
NEXT_PUBLIC_ATTACHMENT_MAX_MB=4

# Segredo do Cron de limpeza diária. Gere com: openssl rand -hex 32
CRON_SECRET=

# SMTP real com TLS. Sem e-mail funcionando, NINGUÉM consegue entrar
# (o login exige o código enviado por e-mail).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM="CampusConnect <nao-responda@seudominio.com.br>"

# LGPD: dados exibidos em /privacidade (definidos pela instituição).
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_LEGAL_BASIS=
